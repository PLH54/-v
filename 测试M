local capturedBuyRemotes = {}
local hookInstalled = false
local scannedItems = {}
local scannedRemotes = {}
local selectedItemName = nil

local function installHook()
    if hookInstalled then return end
    hookInstalled = true
    pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local name = tostring(self.Name):lower()
                if name:find("buy") or name:find("purchase") or name:find("getitem") or name:find("claim") or name:find("shop") or name:find("give") or name:find("backpack") or name:find("inventory") then
                    capturedBuyRemotes[self] = true
                end
            end
            return oldNamecall(self, ...)
        end)
    end)
end

local function findItemContainers()
    local containers = {}
    local seen = {}
    local candidates = {
        "GameItems", "Items", "Weapons", "ShopItems", "ItemData", "Swords", "Guns",
        "Pets", "Tools", "Catalog", "Inventory", "ItemList", "ItemsFolder", "Shop",
        "Assets", "Database", "ItemDB", "StoreItems", "Cosmetics", "Vehicles"
    }
    local roots = {
        ReplicatedStorage,
        game:GetService("ServerStorage"),
        game:GetService("StarterPack"),
        workspace,
    }
    for _, root in ipairs(roots) do
        for _, name in ipairs(candidates) do
            local ok2, obj = pcall(function() return root:FindFirstChild(name, true) end)
            if ok2 and obj and (obj:IsA("Folder") or obj:IsA("Model") or obj:IsA("Configuration")) then
                if not seen[obj] then
                    seen[obj] = true
                    table.insert(containers, obj)
                end
            end
        end
    end
    return containers
end

