local function placeItemInBackpack(itemName)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then
        local char = LocalPlayer.Character
        backpack = char and char:FindFirstChild("Backpack")
    end
    if not backpack then
        pcall(function()
            backpack = Instance.new("Backpack")
            backpack.Parent = LocalPlayer
        end)
    end
    if not backpack then return false end

    local roots = { ReplicatedStorage, game:GetService("ServerStorage"), game:GetService("StarterPack"), workspace }

    for _, root in ipairs(roots) do
        local ok2, found = pcall(function() return root:FindFirstChild(itemName, true) end)
        if ok2 and found and found ~= backpack then
            if found:IsA("Tool") then
                local clone = found:Clone()
                clone.Parent = backpack
                return true
            elseif found:IsA("Model") then
                local handle = found:FindFirstChild("Handle") or found:FindFirstChildWhichIsA("BasePart", true)
                if handle then
                    local tool = Instance.new("Tool")
                    tool.Name = itemName
                    tool.RequiresHandle = false
                    found:Clone().Parent = tool
                    tool.Parent = backpack
                    return true
                end
            end
        end
    end
    return false
end

local function tryFireRemotes(itemName)
    local sent = 0
    if #scannedRemotes == 0 then return sent end
    local payloads = {
        { itemName }, { itemName, 1 }, { itemName, "Buy" }, { itemName, 1, "Buy" },
        { "Buy", itemName }, { itemName, true }, { "Grab", itemName }, { "Get", itemName },
    }
    for _, remote in ipairs(scannedRemotes) do
        for _, args in ipairs(payloads) do
            local ok2 = pcall(function()
                if remote:IsA("RemoteEvent") then
                    remote:FireServer(table.unpack(args))
                elseif remote:IsA("RemoteFunction") then
                    remote:InvokeServer(table.unpack(args))
                end
            end)
            if ok2 then sent = sent + 1 end
            task.wait(0.02)
        end
    end
    return sent
end

