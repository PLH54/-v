local aimbotPartMap = {
    ["Head"] = "Head", ["Torso"] = "Torso",
    ["Left Arm"] = "Left Arm", ["Right Arm"] = "Right Arm",
    ["Left Leg"] = "Left Leg", ["Right Leg"] = "Right Leg",
}

local function getClosestAimbotTarget()
    local camera = workspace.CurrentCamera
    local closest, shortest = nil, aimbotFov
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if aimbotTeamCheck and player.Team == LocalPlayer.Team then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local targetPart = char:FindFirstChild(aimbotPartMap[aimbotPart] or "Head")
        if not targetPart then continue end
        local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
        if dist < shortest then
            shortest = dist
            closest = targetPart
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    updateAimbotFovCircle()
    if not aimbotMasterEnabled then return end
    local target = getClosestAimbotTarget()
    if not target then return end
    local camera = workspace.CurrentCamera
    camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, target.Position), aimbotSmoothness)
end)

