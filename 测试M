-- ========== 性能设置 ==========
local PerformanceTab = Window:Tab({ Title = "性能设置", Icon = "activity" })
PerformanceTab:Section({ Title = "帧率上限设置" })

local fpsCapValue = 60
local fpsLockEnabled = false
local fpsLockThread = nil
local fpsLockTarget = nil
local syncingFps = false
local fpsSlider, fpsInput

local function normalizeFps(n)
    n = tonumber(n)
    if not n then return nil end
    n = math.floor(n + 0.5)
    if n < 1 then n = 1 end
    if n > 9999 then n = 9999 end
    return n
end

local function doSetFps(n)
    n = normalizeFps(n)
    if not n then return false end
    local applied = false
    pcall(function()
        if type(setfpscap) == "function" then setfpscap(n) applied = true end
    end)
    if not applied then
        pcall(function()
            local env = getgenv and getgenv() or _G
            if env and type(env.setfpscap) == "function" then env.setfpscap(n) applied = true end
        end)
    end
    if not applied then
        pcall(function()
            local settings = UserSettings():GetService("UserGameSettings")
            if settings and settings.SetFpsCap then settings:SetFpsCap(n) applied = true end
        end)
    end
    return applied
end

local function stopFpsLock()
    fpsLockEnabled = false
    fpsLockTarget = nil
    if fpsLockThread then pcall(function() task.cancel(fpsLockThread) end) fpsLockThread = nil end
end

local function startFpsLock(n)
    n = normalizeFps(n)
    if not n then return false end
    stopFpsLock()
    fpsCapValue = n
    local okApplied = doSetFps(n)
    fpsLockEnabled = true
    fpsLockTarget = n
    fpsLockThread = task.spawn(function()
        while fpsLockEnabled and fpsLockTarget == n do
            doSetFps(n)
            task.wait(0.3)
        end
    end)
    return okApplied
end

local function syncFpsUI(n)
    syncingFps = true
    pcall(function() if fpsSlider then fpsSlider:Set(n) end end)
    pcall(function() if fpsInput and fpsInput.Set then fpsInput:Set(tostring(n)) end end)
    syncingFps = false
end

fpsSlider = PerformanceTab:Slider({
    Title = "帧率上限（滑动）",
    Step = 1,
    Value = { Min = 1, Max = 9999, Default = 60 },
    Callback = function(v)
        if syncingFps then return end
        v = normalizeFps(v)
        if not v then return end
        fpsCapValue = v
        if v <= 60 then
            local okApplied = startFpsLock(v)
            pcall(function() if fpsInput and fpsInput.Set then fpsInput:Set(tostring(v)) end end)
            if okApplied then
                WindUI:Notify({ Title = "帧率", Content = "已自动锁定 " .. v .. " FPS", Duration = 2, Icon = "activity" })
            end
        end
    end,
})

fpsInput = PerformanceTab:Input({
    Title = "帧率上限（输入）",
    Value = "60",
    Placeholder = "1 - 9999",
    Callback = function(text)
        if syncingFps then return end
        local n = normalizeFps(text)
        if n then fpsCapValue = n end
    end,
})

PerformanceTab:Button({
    Title = "确认应用帧率上限",
    Callback = function()
        local n = normalizeFps(fpsCapValue)
        if not n then return end
        syncFpsUI(n)
        startFpsLock(n)
        WindUI:Notify({ Title = "帧率", Content = "已锁定 " .. n .. " FPS", Duration = 3, Icon = "activity" })
    end,
})

PerformanceTab:Button({
    Title = "解除帧率锁定",
    Callback = function()
        stopFpsLock()
        WindUI:Notify({ Title = "帧率", Content = "已解除锁定", Duration = 2, Icon = "unlock" })
    end,
})

