local DEFAULT_SPEED = 16
local MAX_SPEED = 500
local currentSpeed = DEFAULT_SPEED
local noclipEnabled = false

local function getHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function setSpeed(value)
    currentSpeed = value
    local hum = getHumanoid()
    if hum then
        pcall(function() hum.WalkSpeed = value end)
    end
end

local function reapplyNoclip()
    if not noclipEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
end

local customHealth = 100
local originalMaxHealth = nil
local healthLockEnabled = false
local healthLockConn = nil

local function applyCustomHealth(value)
    local hum = getHumanoid()
    if not hum then return false end
    if originalMaxHealth == nil then
        originalMaxHealth = hum.MaxHealth
    end
    pcall(function()
        if value > originalMaxHealth then
            hum.MaxHealth = value
        else
            hum.MaxHealth = originalMaxHealth
        end
        hum.Health = value
    end)
    return true
end

local function restoreDefaultHealth()
    local hum = getHumanoid()
    if not hum then return false end
    pcall(function()
        hum.MaxHealth = originalMaxHealth or 100
        hum.Health = hum.MaxHealth
    end)
    return true
end

local currentJumpHeight = 7.2
local DEFAULT_JUMP_HEIGHT = 7.2

local function applyJumpHeight(value)
    value = tonumber(value)
    if not value then return false end
    currentJumpHeight = value
    local hum = getHumanoid()
    if hum then
        pcall(function()
            hum.UseJumpPower = false
            hum.JumpHeight = value
        end)
        return true
    end
    return false
end

local function restoreDefaultJumpHeight()
    currentJumpHeight = DEFAULT_JUMP_HEIGHT
    local hum = getHumanoid()
    if hum then
        pcall(function()
            hum.UseJumpPower = true
            hum.JumpPower = 50
            hum.JumpHeight = DEFAULT_JUMP_HEIGHT
        end)
        return true
    end
    return false
end

