    Desc = "扫描并复制全服已装备 Tool，同时尝试调用背包远程",
    Callback = function()
        installHook()
        local myBackpack = LocalPlayer:FindFirstChild("Backpack")
        if not myBackpack then
            local myChar = LocalPlayer.Character
            myBackpack = myChar and myChar:FindFirstChild("Backpack")
        end
        if not myBackpack then
            pcall(function()
                myBackpack = Instance.new("Backpack")
                myBackpack.Parent = LocalPlayer
            end)
        end
        if not myBackpack then
            WindUI:Notify({ Title = "偷取道具", Content = "无法创建背包", Duration = 4, Icon = "alert-circle" })
            return
        end

        local stolen, seenNames = {}, {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local char = player.Character
            if not char then continue end
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") and not seenNames[child.Name] then
                    seenNames[child.Name] = true
                    local okClone, clone = pcall(function() return child:Clone() end)
                    if okClone and clone then
                        clone.Parent = myBackpack
                        table.insert(stolen, player.Name .. " → " .. child.Name)
                    end
                end
            end
        end

        local backpackRemotes = {}
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = tostring(obj.Name):lower()
                if n:find("backpack") or n:find("inventory") then
                    table.insert(backpackRemotes, obj)
                end
            end
        end
        for _, remote in ipairs(backpackRemotes) do
            for _, target in ipairs(Players:GetPlayers()) do
                if target == LocalPlayer then continue end
                local payloads = { { "Grab", target.Name }, { "Get", target.Name }, { "Get", target } }
                for _, args in ipairs(payloads) do
                    pcall(function()
                        if remote:IsA("RemoteFunction") then
                            local result = remote:InvokeServer(table.unpack(args))
                            if type(result) == "table" then
                                for _, item in ipairs(result) do
                                    local itemName = type(item) == "string" and item or (type(item) == "Instance" and item.Name)
                                    if itemName and not seenNames[itemName] then
                                        seenNames[itemName] = true
                                        if placeItemInBackpack(itemName) then
                                            table.insert(stolen, target.Name .. " (远程) → " .. itemName)
                                        end
                                    end
                                end
                            end
                        else
                            remote:FireServer(table.unpack(args))
                        end
                    end)
                    task.wait(0.02)
                end
            end
        end

        if #stolen == 0 then
            WindUI:Notify({ Title = "偷取道具", Content = "未发现可复制道具。", Duration = 5, Icon = "search-x" })
        else
            WindUI:Notify({ Title = "偷取道具", Content = string.format("成功 %d 项：\n%s", #stolen, table.concat(stolen, "\n")), Duration = 10, Icon = "copy" })
        end
    end,
})

-- ========== 玩家操控（多目标：玩家1 / 玩家2 / 玩家3） ==========
local ControlTab = Window:Tab({ Title = "玩家操控", Icon = "users" })

local PlayerControl = {}
local CONTROL_SLOT_COUNT = 3

local function getPlayerNamesForControl()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    return names
end

local function createControlSlot(slotIndex)
    local C = {
        index = slotIndex,
        targetPlayer = nil,
        teleportDistance = 5,
        loopTPEnabled = false,
        loopTPConn = nil,
        rotateEnabled = false,
        rotateConn = nil,
        orbitEnabled = false,
        orbitConn = nil,
        orbitAngle = 0,
        orbitRadius = 10,
        orbitSpeed = 90,
        orbitLockedRotation = nil,
        dropdown = nil,
        orbitRadiusSlider = nil,
        orbitRadiusInput = nil,
    }

    local SubTab = ControlTab:Tab({ Title = "玩家" .. slotIndex, Icon = "user" })
    SubTab:Section({ Title = "选择目标玩家" })

    C.dropdown = SubTab:Dropdown({
        Title = "选择目标玩家 " .. slotIndex,
        Desc = "选择后，下方操作只作用于这个玩家",
        Values = getPlayerNamesForControl(),
        Value = nil,
        Callback = function(name)
            C.targetPlayer = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name == name then
                    C.targetPlayer = p
                    break
                end
            end
        end,
    })

    SubTab:Button({
        Title = "刷新玩家列表",
        Callback = function()
            local names = getPlayerNamesForControl()
            pcall(function() C.dropdown:Refresh(names) end)
            WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "已刷新，共 " .. #names .. " 名玩家", Duration = 2, Icon = "refresh-cw" })
        end,
    })

    SubTab:Slider({
        Title = "传送距离",
        Desc = "与目标玩家保持的距离（格）",
        Step = 1,
        Value = { Min = 1, Max = 50, Default = 5 },
        Callback = function(v) C.teleportDistance = v end,
    })

    local function getMyRoot()
        local char = LocalPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function getTargetRoot()
        if not C.targetPlayer then return nil end
        local char = C.targetPlayer.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function teleportTargetOnce()
        if not C.targetPlayer or C.targetPlayer == LocalPlayer then return false end
        local myRoot = getMyRoot()
        local targetRoot = getTargetRoot()
        if not myRoot or not targetRoot then return false end
        pcall(function() targetRoot:SetNetworkOwner(LocalPlayer) end)
        local targetPos = myRoot.Position + myRoot.CFrame.LookVector * C.teleportDistance + Vector3.new(0, 3, 0)
        pcall(function()
            targetRoot.CFrame = CFrame.new(targetPos) * (targetRoot.CFrame - targetRoot.Position)
        end)
        return true
    end

    local function teleportSelfToTarget()
        local myRoot = getMyRoot()
        local targetRoot = getTargetRoot()
        if not myRoot or not targetRoot then return false end
        local offset = targetRoot.CFrame.LookVector * C.teleportDistance + Vector3.new(0, 3, 0)
        pcall(function()
            myRoot.CFrame = CFrame.new(targetRoot.Position + offset) * (myRoot.CFrame - myRoot.Position)
        end)
        return true
    end

    SubTab:Section({ Title = "传送控制" })

    SubTab:Button({
        Title = "传送过来（单次）",
        Desc = "把选中玩家传送到你附近",
        Callback = function()
            if teleportTargetOnce() then
                WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "已传送 " .. C.targetPlayer.Name, Duration = 2, Icon = "arrow-down" })
            else
                WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "请先选择玩家或角色未加载", Duration = 2, Icon = "alert-circle" })
            end
        end,
    })

    SubTab:Toggle({
        Title = "循环传送（拉过来）",
        Desc = "持续把选中玩家拉到你附近",
        Value = false,
        Callback = function(state)
            C.loopTPEnabled = state
            if C.loopTPConn then C.loopTPConn:Disconnect() C.loopTPConn = nil end
            if not state then return end
            C.loopTPConn = RunService.Heartbeat:Connect(function()
                if not C.loopTPEnabled then return end
                if C.targetPlayer then pcall(teleportTargetOnce) end
            end)
        end,
    })

    SubTab:Button({
        Title = "传送到玩家旁边（单次）",
        Desc = "把你自己传送到选中玩家旁边",
        Callback = function()
            if teleportSelfToTarget() then
                WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "已传送到 " .. C.targetPlayer.Name .. " 旁边", Duration = 2, Icon = "arrow-up" })
            else
                WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "传送失败", Duration = 2, Icon = "alert-circle" })
            end
        end,
    })

    local loopSelfTPConn = nil
    SubTab:Toggle({
        Title = "循环传送到玩家旁边",
        Desc = "持续把你传送到选中玩家旁边",
        Value = false,
        Callback = function(state)
            if loopSelfTPConn then loopSelfTPConn:Disconnect() loopSelfTPConn = nil end
            if not state then return end
            loopSelfTPConn = RunService.Heartbeat:Connect(function()
                if C.targetPlayer then pcall(teleportSelfToTarget) end
            end)
        end,
    })

    SubTab:Section({ Title = "旋转与环绕" })

    SubTab:Toggle({
        Title = "旋转玩家",
        Desc = "让选中玩家持续快速旋转",
        Value = false,
        Callback = function(state)
            C.rotateEnabled = state
            if C.rotateConn then C.rotateConn:Disconnect() C.rotateConn = nil end
            if not state then
                if C.targetPlayer then
                    local char = C.targetPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                pcall(function() part.AssemblyAngularVelocity = Vector3.zero end)
                            end
                        end
                    end
                end
                return
            end
            C.rotateConn = RunService.Heartbeat:Connect(function()
                if not C.rotateEnabled or not C.targetPlayer then return end
                local char = C.targetPlayer.Character
                if not char then return end
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        pcall(function()
                            part.AssemblyAngularVelocity = Vector3.new(math.random(-50, 50), 500, math.random(-50, 50))
                        end)
                    end
                end
            end)
        end,
    })

    C.orbitRadiusSlider = SubTab:Slider({
        Title = "环绕半径",
        Desc = "环绕选中玩家时的半径（格）",
        Step = 1,
        Value = { Min = 1, Max = 200, Default = 10 },
        Callback = function(v)
            C.orbitRadius = v
            if C.orbitRadiusInput and C.orbitRadiusInput.Set then
                pcall(function() C.orbitRadiusInput:Set(tostring(v)) end)
            end
        end,
    })

    C.orbitRadiusInput = SubTab:Input({
        Title = "环绕半径（输入）",
        Value = "10",
        Placeholder = "1 - 200",
        Callback = function(text)
            local n = tonumber(text)
            if n then
                n = math.clamp(math.floor(n + 0.5), 1, 200)
                C.orbitRadius = n
                if C.orbitRadiusSlider and C.orbitRadiusSlider.Set then
                    pcall(function() C.orbitRadiusSlider:Set(n) end)
                end
            end
        end,
    })

    SubTab:Slider({
        Title = "环绕速度（度/秒）",
        Step = 5,
        Value = { Min = 10, Max = 720, Default = 90 },
        Callback = function(v) C.orbitSpeed = v end,
    })

    SubTab:Button({
        Title = "开始环绕",
        Desc = "把你传送到目标旁边并按半径/速度环绕",
        Callback = function()
            if not C.targetPlayer then
                WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "请先选择目标", Duration = 2, Icon = "alert-circle" })
                return
            end
            local myRoot = getMyRoot()
            local targetRoot = getTargetRoot()
            if not myRoot or not targetRoot then
                WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "角色未加载", Duration = 2, Icon = "alert-circle" })
                return
            end
            if C.orbitConn then C.orbitConn:Disconnect() C.orbitConn = nil end
            C.orbitEnabled = true
            C.orbitAngle = 0
            C.orbitLockedRotation = myRoot.CFrame - myRoot.Position
            pcall(teleportSelfToTarget)
            C.orbitConn = RunService.Heartbeat:Connect(function(dt)
                if not C.orbitEnabled then return end
                local mRoot = getMyRoot()
                local tRoot = getTargetRoot()
                if not mRoot or not tRoot then
                    C.orbitEnabled = false
                    if C.orbitConn then C.orbitConn:Disconnect() C.orbitConn = nil end
                    return
                end
                C.orbitAngle = C.orbitAngle + math.rad(C.orbitSpeed) * dt
                if C.orbitAngle > math.rad(360) then C.orbitAngle = C.orbitAngle - math.rad(360) end
                local offset = Vector3.new(
                    math.cos(C.orbitAngle) * C.orbitRadius, 3, math.sin(C.orbitAngle) * C.orbitRadius
                )
                pcall(function()
                    mRoot.CFrame = CFrame.new(tRoot.Position + offset) * (C.orbitLockedRotation or (mRoot.CFrame - mRoot.Position))
                end)
            end)
            WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "开始环绕 " .. C.targetPlayer.Name, Duration = 3, Icon = "rotate-cw" })
        end,
    })

    SubTab:Button({
        Title = "停止环绕",
        Callback = function()
            C.orbitEnabled = false
            if C.orbitConn then C.orbitConn:Disconnect() C.orbitConn = nil end
            WindUI:Notify({ Title = "玩家操控" .. slotIndex, Content = "环绕已停止", Duration = 2, Icon = "square" })
        end,
    })

    PlayerControl[slotIndex] = C
end

for i = 1, CONTROL_SLOT_COUNT do
    createControlSlot(i)
end

