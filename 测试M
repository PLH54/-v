local antiFlingEnabled = false
local antiFlingConn = nil
local MAX_SAFE_VELOCITY = 150

local function resetFlingVelocity()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.AssemblyLinearVelocity.Magnitude > MAX_SAFE_VELOCITY then
                pcall(function() part.AssemblyLinearVelocity = Vector3.zero end)
            end
            if part.AssemblyAngularVelocity.Magnitude > MAX_SAFE_VELOCITY then
                pcall(function() part.AssemblyAngularVelocity = Vector3.zero end)
            end
        end
    end
end

DefenseTab:Toggle({
    Title = "防甩飞1.0",
    Desc = "持续清零异常速度，防止被甩飞",
    Value = false,
    Callback = function(state)
        antiFlingEnabled = state
        if antiFlingConn then antiFlingConn:Disconnect() antiFlingConn = nil end
        if not state then return end
        antiFlingConn = RunService.Heartbeat:Connect(function()
            if antiFlingEnabled then pcall(resetFlingVelocity) end
        end)
    end,
})

DefenseTab:Section({ Title = "防虚空" })

local antiVoidEnabled = false
local antiVoidConn = nil
local lastSafeCFrame = nil
local voidCheckAccumulator = 0

local function updateSafePosition()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if hum.FloorMaterial ~= Enum.Material.Air and hrp.Position.Y > (workspace.FallenPartsDestroyHeight + 30) then
        lastSafeCFrame = hrp.CFrame
    end
end

local function checkAndRescueFromVoid()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if hrp.Position.Y < workspace.FallenPartsDestroyHeight + 30 then
        if lastSafeCFrame then
            pcall(function() hrp.CFrame = lastSafeCFrame hrp.AssemblyLinearVelocity = Vector3.zero end)
            WindUI:Notify({ Title = "防虚空", Content = "已传送回安全位置", Duration = 2, Icon = "shield" })
        else
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = { char }
            params.FilterType = Enum.RaycastFilterType.Exclude
            local result = workspace:Raycast(Vector3.new(hrp.Position.X, 500, hrp.Position.Z), Vector3.new(0, -1000, 0), params)
            if result then
                pcall(function() hrp.CFrame = CFrame.new(result.Position + Vector3.new(0, 5, 0)) hrp.AssemblyLinearVelocity = Vector3.zero end)
                WindUI:Notify({ Title = "防虚空", Content = "已传送到最近地面", Duration = 2, Icon = "shield" })
            end
        end
    end
end

DefenseTab:Toggle({
    Title = "防虚空",
    Desc = "掉落时自动传送回最近的安全地面",
    Value = false,
    Callback = function(state)
        antiVoidEnabled = state
        if antiVoidConn then antiVoidConn:Disconnect() antiVoidConn = nil end
        if not state then lastSafeCFrame = nil return end
        lastSafeCFrame = nil
        antiVoidConn = RunService.Heartbeat:Connect(function()
            if not antiVoidEnabled then return end
            voidCheckAccumulator = voidCheckAccumulator + 1
            if voidCheckAccumulator % 10 == 0 then pcall(updateSafePosition) end
            pcall(checkAndRescueFromVoid)
        end)
    end,
})

